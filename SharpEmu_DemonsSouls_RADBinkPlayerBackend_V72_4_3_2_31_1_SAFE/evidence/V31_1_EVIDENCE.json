    "SHARPEMU_RADVIDEO64",
    "stored config",
    "PATH",
    "running process",
    "Windows Applications/.bk2 registration",
    "common install directories",
    "shallow Downloads/Desktop"
  ],
  "reentrant_default_mode_refresh": true
}
